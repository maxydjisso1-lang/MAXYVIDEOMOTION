# brand-video-engine needs NO API keys. Everything below is optional.

# Explicit binaries (default: resolved from PATH)
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe

# Python interpreter of the uv venv used for transcription (default: engine/python/.venv)
# BVE_PYTHON=engine/python/.venv/Scripts/python.exe

# Where Whisper models are cached (default: ./models)
# WHISPER_MODEL_DIR=./models

# Graphics renderer: auto | remotion | ass   (auto = Remotion when available, else ASS/libass)
# BVE_RENDERER=auto

# Remotion render concurrency (default: half the CPU cores)
# REMOTION_CONCURRENCY=4

# Log level: trace | debug | info | warn | error
# BVE_LOG_LEVEL=info
